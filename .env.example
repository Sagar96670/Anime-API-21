SOURCE_MAX_PAGES=20
SYNC_CONCURRENCY=4
SYNC_INTERVAL_MINUTES=60
ADMIN_API_KEY=change-this-to-a-long-random-secret
CRON_SECRET=change-this-to-a-long-random-secret

# Vercel: connect a private Vercel Blob store to this project.
# Local Docker/Render deployments continue using data/anime-db.json.

# Comma-separated hosts for authorized video/HLS sources used by /api/hls-proxy
AUTHORIZED_VIDEO_HOSTS=cdn.example.com
