{
  "name": "anime-api-21",
  "version": "1.1.2",
  "private": true,
  "description": "Lightweight anime catalog API using Node.js, Express and a bundled JSON file database.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "sync": "node scripts/sync-url.js",
    "sync:url": "node scripts/sync-url.js",
    "sync:auto": "node scripts/auto-sync.js",
    "sync:file": "node scripts/sync-catalog.js",
    "vercel-build": "VERCEL_BUILD_SYNC=1 npm run sync"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0"
  }
}
